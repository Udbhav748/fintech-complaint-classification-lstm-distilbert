# Source data stays local. The raw CFPB extract is reproducible from the
# acquisition manifest and must not be committed.
#
# Each level is re-included before its contents are excluded, because git will
# not descend into an ignored directory - a bare `data/raw/` would make the
# negations below unreachable and silently drop the README and the manifest.
data/interim/
data/processed/

data/raw/*
!data/raw/cfpb/

data/raw/cfpb/*
!data/raw/cfpb/README.md
!data/raw/cfpb/manifests/

# Documentation and audit trail are tracked; the extract itself is not.
data/raw/cfpb/manifests/*
!data/raw/cfpb/manifests/*.json

!data/**/.gitkeep

# Pretrained vectors and model caches
embeddings/
data/embeddings/
*.txt.gz
*.zip
kaggle_output/
*.txt
glove*/

# Anchored to the repository root on purpose: an unanchored `models/` also
# matches `src/models/`, which would silently drop the model source code.
/models/
/checkpoints/
*.h5
*.keras
*.pt
*.pth
*.safetensors
.cache/
transformers_cache/
hf_cache/

# Environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Secrets
.env
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
